NODE_ENV=development
PORT=5100

# MongoDB Atlas connection string — include the database name (e.g. /tours-website)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tours-website?retryWrites=true&w=majority

# 2Factor.in — dashboard → API key. Required when NODE_ENV=production.
# In development, if this is left blank the OTP is printed to the server console instead of sent by SMS.
TWO_FACTOR_API_KEY=
# Optional: DLT-approved OTP template name registered in your 2Factor account.
# Leave blank to use 2Factor's default OTP template.
TWO_FACTOR_TEMPLATE=

# Development only: a fixed 6-digit OTP that skips the SMS, so testing does not spend credits.
# The server refuses to start with this set when NODE_ENV=production. Leave blank for real OTPs.
DEMO_OTP=

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=30

# CORS — comma-separated list of frontend origins (no wildcard: the session cookie needs credentials)
ALLOWED_ORIGINS=http://localhost:3000
